generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                        String      @id @default(uuid())
  name                      String
  industry                  String      @default("OTHER")
  customIndustryDescription String?
  planTier                  String      @default("MULTI_POD_ENTERPRISE")
  totalSeats                Int         @default(8)
  leadershipMode            String      @default("UNIFIED")
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  users                     User[]
  workspaces                Workspace[]

  @@map("organizations")
}

model User {
  id                  String                @id @default(uuid())
  username            String?               @unique
  email               String                @unique
  phone               String?
  passwordHash        String
  fullName            String
  role                Role                  @default(CUSTOMER)
  avatarUrl           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  onboardingCompleted Boolean               @default(false)
  verificationMethod  String?               @default("EMAIL")
  organizationId      String?
  auditLogs           AuditLog[]
  messages            Message[]
  assignedTickets     Ticket[]              @relation("AgentTickets")
  createdTickets      Ticket[]              @relation("CustomerTickets")
  activitySessions    UserActivitySession[]
  organization        Organization?         @relation(fields: [organizationId], references: [id])
  workspaceMembership WorkspaceMember?      @relation("WorkspaceMembership")
  ownedWorkspaces     Workspace[]           @relation("WorkspaceOwner")

  @@index([organizationId])
  @@map("users")
}

model Workspace {
  id             String                 @id @default(uuid())
  name           String
  inviteToken    String                 @default(uuid())
  ownerId        String
  maxMembers     Int                    @default(8)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  description    String?
  isCatchAll     Boolean                @default(false)
  organizationId String?
  podCategory    String                 @default("GENERAL")
  assignedQuota  Int                    @default(8)
  isQuotaLocked  Boolean                @default(false)
  lockedAt       DateTime?
  services       String[]               @default([])
  tickets        Ticket[]               @relation("WorkspaceTickets")
  inviteTokens   WorkspaceInviteToken[]
  members        WorkspaceMember[]
  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceInviteToken {
  id          String    @id @default(uuid())
  workspaceId String
  token       String    @unique
  isUsed      Boolean   @default(false)
  usedBy      String?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  role        String    @default("LEADER")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
  @@map("workspace_invite_tokens")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String    @unique
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now())
  user        User      @relation("WorkspaceMembership", fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_members")
}

model Ticket {
  id              String       @id @default(uuid())
  ticketNumber    Int          @unique @default(autoincrement())
  title           String
  description     String
  status          TicketStatus @default(NEW)
  priority        Priority     @default(MEDIUM)
  sentiment       Sentiment    @default(NEUTRAL)
  tags            String[]     @default([])
  customerId      String
  assignedAgentId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  customerName    String?
  workspaceId     String?
  auditLogs       AuditLog[]
  messages        Message[]
  assignedAgent   User?        @relation("AgentTickets", fields: [assignedAgentId], references: [id])
  customer        User         @relation("CustomerTickets", fields: [customerId], references: [id])
  workspace       Workspace?   @relation("WorkspaceTickets", fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([status, priority])
  @@index([customerId])
  @@index([assignedAgentId])
  @@map("tickets")
}

model Message {
  id          String      @id @default(uuid())
  ticketId    String
  senderId    String
  type        MessageType @default(PUBLIC_REPLY)
  content     String
  aiGenerated Boolean     @default(false)
  createdAt   DateTime    @default(now())
  sender      User        @relation(fields: [senderId], references: [id])
  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("messages")
}

model KnowledgeArticle {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  tags      String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledge_articles")
}

model AuditLog {
  id        String   @id @default(uuid())
  ticketId  String
  actorId   String
  action    String
  details   Json?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("audit_logs")
}

model UserActivitySession {
  id              String    @id @default(uuid())
  userId          String
  organizationId  String?
  workspaceId     String?
  role            String    @default("AGENT")
  loginAt         DateTime  @default(now())
  lastHeartbeatAt DateTime  @default(now())
  logoutAt        DateTime?
  logoutReason    String?
  isOnline        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([workspaceId])
  @@map("user_activity_sessions")
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  FRUSTRATED
  URGENT
}

enum MessageType {
  PUBLIC_REPLY
  INTERNAL_NOTE
  SYSTEM_EVENT
}
