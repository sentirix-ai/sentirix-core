# Server Environment
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db_sevaniq?schema=public"

# Authentication & Security
JWT_SECRET="change-me-to-a-64-char-random-secret-in-env"
JWT_EXPIRATION="7d"
ADMIN_USERNAME="pungkyrama"
ADMIN_EMAIL="admin@sevaniq.enterprise"
ADMIN_PASSWORD="change-me-in-production"

# Google Gemini AI API Key
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Client CORS Origins & Join URL Base
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
